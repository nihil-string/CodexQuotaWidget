<Window x:Class="CodexQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota Widget"
        Width="324" Height="176"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PrimaryText" Color="#F4F3EF" />
    <SolidColorBrush x:Key="SecondaryText" Color="#92989F" />
    <SolidColorBrush x:Key="Hairline" Color="#36404850" />
    <SolidColorBrush x:Key="Track" Color="#303A4147" />
    <SolidColorBrush x:Key="Progress" Color="#D9DBD8D2" />
  </Window.Resources>

  <Border x:Name="ShellBorder"
          CornerRadius="0"
          BorderThickness="0"
          Background="#15161A1F"
          MouseLeftButtonDown="Header_MouseLeftButtonDown">
    <Grid Margin="17,13,17,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="25" />
        <RowDefinition Height="1" />
        <RowDefinition Height="58" />
        <RowDefinition Height="1" />
        <RowDefinition Height="58" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock Text="Codex"
                   Foreground="{StaticResource PrimaryText}"
                   FontFamily="Bahnschrift"
                   FontWeight="SemiBold"
                   FontSize="14"
                   VerticalAlignment="Top" />

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,1,0">
          <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#76D9C0" Margin="0,3,6,0" />
          <TextBlock x:Name="StatusText"
                     Text="连接中"
                     Foreground="{StaticResource SecondaryText}"
                     FontFamily="Microsoft YaHei UI"
                     FontSize="9" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource Hairline}" />

      <Grid Grid.Row="2" Margin="0,9,0,7">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="2" />
        </Grid.RowDefinitions>
        <Grid>
          <StackPanel VerticalAlignment="Top">
            <TextBlock Text="5 小时"
                       Foreground="{StaticResource PrimaryText}"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="Medium"
                       FontSize="12" />
            <TextBlock x:Name="FiveHourReset"
                       Text="等待额度状态"
                       Foreground="{StaticResource SecondaryText}"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="10"
                       Margin="0,5,0,0" />
          </StackPanel>

          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock x:Name="FiveHourPercent"
                       Text="--"
                       Foreground="{StaticResource PrimaryText}"
                       FontFamily="Bahnschrift SemiCondensed"
                       FontWeight="SemiBold"
                       FontSize="28" />
            <TextBlock Text="剩余"
                       Foreground="{StaticResource SecondaryText}"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="8.5"
                       Margin="7,15,0,0" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource Track}" CornerRadius="1">
          <Border x:Name="FiveHourBar"
                  HorizontalAlignment="Left"
                  Background="{StaticResource Progress}"
                  CornerRadius="1"
                  Width="0" />
        </Border>
      </Grid>

      <Border Grid.Row="3" Background="{StaticResource Hairline}" />

      <Grid Grid.Row="4" Margin="0,9,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="2" />
        </Grid.RowDefinitions>
        <Grid>
          <StackPanel VerticalAlignment="Top">
            <TextBlock Text="每周"
                       Foreground="{StaticResource PrimaryText}"
                       FontFamily="Microsoft YaHei UI"
                       FontWeight="Medium"
                       FontSize="12" />
            <TextBlock x:Name="WeeklyReset"
                       Text="每 60 秒在线刷新"
                       Foreground="{StaticResource SecondaryText}"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="10"
                       Margin="0,5,0,0" />
          </StackPanel>

          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBlock x:Name="WeeklyPercent"
                       Text="--"
                       Foreground="{StaticResource PrimaryText}"
                       FontFamily="Bahnschrift SemiCondensed"
                       FontWeight="SemiBold"
                       FontSize="28" />
            <TextBlock Text="剩余"
                       Foreground="{StaticResource SecondaryText}"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="8.5"
                       Margin="7,15,0,0" />
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource Track}" CornerRadius="1">
          <Border x:Name="WeeklyBar"
                  HorizontalAlignment="Left"
                  Background="{StaticResource Progress}"
                  CornerRadius="1"
                  Width="0" />
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
