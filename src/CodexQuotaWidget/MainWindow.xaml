<Window x:Class="CodexQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CodexQuotaWidget.Controls"
        Title="Codex Quota Widget"
        Width="148" MinWidth="64" Height="28"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="False" Background="#FAFAFA"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" Topmost="False"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <SolidColorBrush x:Key="PrimaryText" Color="#5F6368" />
    <SolidColorBrush x:Key="SecondaryText" Color="#7A7F85" />
    <SolidColorBrush x:Key="Hairline" Color="#30000000" />

    <Style TargetType="{x:Type ContextMenu}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#F2F1EC" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Background="#F01A2026"
                    BorderBrush="#52616A73"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="5"
                    MinWidth="156">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.34" Color="#000000" />
              </Border.Effect>
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
      <Setter Property="Foreground" Value="#F2F1EC" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Height" Value="29" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="6">
              <Grid Margin="9,0,10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="15" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CheckGlyph"
                           Text="✓"
                           FontFamily="Segoe UI Symbol"
                           FontSize="10"
                           Foreground="#76D9C0"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemSurface" Property="Background" Value="#31424B53" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}">
      <Setter Property="Height" Value="7" />
      <Setter Property="Margin" Value="9,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Separator}">
            <Border Height="1" Background="#36434B52" VerticalAlignment="Center" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="ShellBorder" Background="Transparent" Padding="2,0">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="FiveHourColumn" Width="*" />
        <ColumnDefinition x:Name="QuotaSeparatorColumn" Width="1" />
        <ColumnDefinition x:Name="WeeklyColumn" Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel x:Name="FiveHourPanel"
                  Grid.Column="0"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Ellipse Width="5" Height="5" Fill="#3B82F6" Margin="0,0,5,0" />
        <TextBlock FontFamily="Segoe UI, Microsoft YaHei UI"
                   FontSize="11"
                   VerticalAlignment="Center">
          <TextBlock.Inlines>
            <Run x:Name="FiveHourLabel"
                 Text="5h "
                 Foreground="{StaticResource SecondaryText}" />
            <Run x:Name="FiveHourPercent"
                 Text="—"
                 Foreground="{StaticResource PrimaryText}"
                 FontWeight="SemiBold" />
          </TextBlock.Inlines>
        </TextBlock>
        <controls:CircularProgress x:Name="FiveHourRing" Visibility="Collapsed" />
        <TextBlock x:Name="FiveHourReset" Visibility="Collapsed" />
      </StackPanel>

      <Border x:Name="QuotaSeparator"
              Grid.Column="1"
              Width="1"
              Height="12"
              Background="{StaticResource Hairline}"
              VerticalAlignment="Center" />

      <StackPanel x:Name="WeeklyPanel"
                  Grid.Column="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <controls:CircularProgress x:Name="WeeklyRing"
                                   Width="10" Height="10"
                                   TrackBrush="#30000000"
                                   ProgressBrush="#10B981"
                                   StrokeThickness="1.5"
                                   Margin="0,0,5,0" />
        <TextBlock FontFamily="Segoe UI, Microsoft YaHei UI"
                   FontSize="11"
                   VerticalAlignment="Center">
          <TextBlock.Inlines>
            <Run x:Name="WeeklyLabel"
                 Text="周 "
                 FontFamily="Microsoft YaHei UI"
                 Foreground="{StaticResource SecondaryText}" />
            <Run x:Name="WeeklyPercent"
                 Text="—"
                 Foreground="{StaticResource PrimaryText}"
                 FontWeight="SemiBold" />
          </TextBlock.Inlines>
        </TextBlock>
        <TextBlock x:Name="WeeklyReset" Visibility="Collapsed" />
      </StackPanel>

      <Grid Visibility="Collapsed">
        <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="#76D9C0" />
        <TextBlock x:Name="StatusText" Text="连接中" />
      </Grid>
    </Grid>
  </Border>
</Window>
